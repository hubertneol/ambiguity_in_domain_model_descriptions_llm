@startuml
class Kinepolis {
}

class Cinema {
  town : String
}

class Theatre {
  numberOfSeats : Integer
}

class Seat {
  seatNumber : String
}

class Movie {
}

class MovieCopy {
}

class WeeklyProgram {
  startDate : Date
  endDate : Date
  publicationDate : Date
}

class Show {
  startTime : DateTime
  publishedAt : DateTime
  availableSeats : Integer
  status : ShowStatus
}

enum ShowStatus {
  PROGRAMMED
  PUBLISHED
  CANCELLED
}

class Customer {
  homeAddress : String
}

class SeatReservation {
  reservedAt : DateTime
  cancelledAt : DateTime
  status : ReservationStatus
}

enum ReservationStatus {
  ACTIVE
  CANCELLED
}

class CreditCard {
}

class CardDebit {
  debitedAt : DateTime
}

class NewSeatOffer {
  expiresAt : DateTime
  status : OfferStatus
}

enum OfferStatus {
  PENDING
  ACCEPTED
  DECLINED
  EXPIRED
}

class Ticket {
}

class EntranceTicket {
  issuedAt : DateTime
}

class FreeTicket {
  sentAt : DateTime
}

Ticket <|-- EntranceTicket
Ticket <|-- FreeTicket

Kinepolis "1" o-- "1..*" Cinema
Kinepolis "1" -- "0..*" WeeklyProgram
Cinema "1" *-- "1..*" Theatre
Theatre "1" *-- "1..*" Seat
Cinema "1" -- "0..*" MovieCopy
Movie "1" *-- "1..*" MovieCopy
WeeklyProgram "1" *-- "1..*" Show
Theatre "1" -- "0..*" Show
Movie "1" -- "0..*" Show
MovieCopy "1" -- "0..*" Show
Customer "1" -- "0..*" SeatReservation
Show "1" -- "0..*" SeatReservation
Seat "1" -- "0..*" SeatReservation
CreditCard "1" -- "0..*" SeatReservation
SeatReservation "1" -- "0..1" CardDebit
CreditCard "1" -- "0..*" CardDebit
SeatReservation "1" -- "0..1" NewSeatOffer
Show "1" -- "0..*" NewSeatOffer
Seat "1" -- "0..*" NewSeatOffer
Show "1" -- "0..*" EntranceTicket
Seat "1" -- "0..*" EntranceTicket
SeatReservation "1" -- "0..1" FreeTicket
Customer "1" -- "0..*" FreeTicket
@enduml

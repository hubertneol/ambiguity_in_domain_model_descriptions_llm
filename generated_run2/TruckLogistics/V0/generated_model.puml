@startuml
class Location {
}

class Address {
}

class Driver {
  firstName : String
  lastName : String
}

class Vehicle {
  vehicleNumber : String
}

class Truck {
  weight : Decimal
}

class Car {
  numberOfSeats : Integer
}

class Van {
}

class Order {
  executionDate : Date
}

Vehicle <|-- Truck
Vehicle <|-- Car
Vehicle <|-- Van

Location "1" *-- "1" Address
Location "1" *-- "0..*" Driver
Location "1" *-- "0..*" Vehicle
Order "0..1" -- "1..*" Driver
Driver "0..1" -- "0..*" Vehicle
Location "1" -- "0..*" Order : origin
Location "1" -- "0..*" Order : destination
@enduml

@startuml
class Cab {
}

class CarOwner {
}

class Customer {
  customerNumber : String
  name : String
}

class TaxiService {
  pickupTime : DateTime
  dropoffTime : DateTime
  pickupLocation : String
  dropoffLocation : String
  rideDuration : Duration
  distance : Decimal
}

class RideHail {
  numberOfPassengers : Integer
  fee : Decimal
  requestType : RequestType
}

class RideShare {
  numberOfPassengers : Integer
  upfrontNegotiatedFee : Decimal
}

class Accident {
  accidentDate : Date
  location : String
  damageAmount : Decimal
}

enum RequestType {
  SOBER_APP
  HAND_WAVING
}

TaxiService <|-- RideHail
TaxiService <|-- RideShare
CarOwner "0..1" -- "0..*" Cab
Cab "1" -- "0..*" TaxiService
Cab "1" -- "0..*" Accident
RideHail "0..*" -- "1" Customer
RideShare "0..*" -- "1..10" Customer
@enduml

@startuml
class Person {
  firstName : String
  lastName : String
}

class Teacher {
  emailAddress : String
}

class Student {
}

class School {
  name : String
}

class TeachingRelationship {
  numberOfHours : Number
}

class Principalship {
}

class Room {
  name : String
}

class Classroom {
  capacity : Integer
}

class OtherRoom {
  sizeInSquareMeters : Number
}

class ClassGroup {
  name : String
}

Person <|-- Teacher
Person <|-- Student
Room <|-- Classroom
Room <|-- OtherRoom

School "1" -- "0..*" Student
Teacher "1" -- "1..3" TeachingRelationship
School "1" -- "1..*" TeachingRelationship
Teacher "1" -- "0..1" Principalship
School "1" -- "1" Principalship
School "1" *-- "1..*" Room
ClassGroup "1" -- "31..10" Student
Classroom "1" -- "1" ClassGroup
@enduml

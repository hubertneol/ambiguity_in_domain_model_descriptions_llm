@startuml
class School {
  name : String
}

class Person {
  firstName : String
  lastName : String
}

class Teacher {
  emailAddress : String
}

class Student {
}

class TeachingAssignment {
  teachingHours : Real
}

class Principalship {
}

class Room {
  name : String
}

class Classroom {
  capacity : Integer
}

class OtherRoom {
  sizeInSquareMeters : Real
}

class ClassGroup {
  name : String
}

Person <|-- Teacher
Person <|-- Student
Room <|-- Classroom
Room <|-- OtherRoom

Teacher "1" -- "1..3" TeachingAssignment
School "1" -- "1..*" TeachingAssignment

School "1" -- "1" Principalship
Teacher "1" -- "0..1" Principalship

School "1" -- "0..*" Student
School "1" *-- "1..*" Room

ClassGroup "1" -- "10..31" Student
Classroom "1" -- "1" ClassGroup
@enduml

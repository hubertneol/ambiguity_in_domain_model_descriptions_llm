@startuml
class Customer {
  vatNumber : String
}

class Address {
  address : String
}

class HeadOfficeAddress {
}

class DeliveryAddress {
}

class Product {
  currentStock : Integer
}

class Order {
  shippingStatus : OrderShippingStatus
}

class OrderLine {
  quantity : Integer
}

class Invoice {
  paymentTiming : PaymentTiming
  paymentStatus : PaymentStatus
  paidAt : DateTime
}

class Shipment {
  status : ShipmentStatus
  packedAt : DateTime
  shippedAt : DateTime
  receivedAt : DateTime
}

enum PaymentTiming {
  WHEN_ORDER_PLACED
  AFTER_DELIVERY
}

enum PaymentStatus {
  UNPAID
  PAID
}

enum OrderShippingStatus {
  NOT_SHIPPED
  PARTIALLY_SHIPPED
  FULLY_SHIPPED
}

enum ShipmentStatus {
  PACKED
  SHIPPED
  RECEIVED
}

Address <|-- HeadOfficeAddress
Address <|-- DeliveryAddress

Customer "1" -- "1" HeadOfficeAddress
Customer "1" -- "0..*" DeliveryAddress
Customer "1" -- "0..*" Order
DeliveryAddress "1" -- "0..*" Order
Order "1" *-- "1..*" OrderLine
Product "1" -- "0..*" OrderLine
Order "1" *-- "1" Invoice
Order "1" *-- "0..*" Shipment
Shipment "0..1" -- "1..*" OrderLine
@enduml

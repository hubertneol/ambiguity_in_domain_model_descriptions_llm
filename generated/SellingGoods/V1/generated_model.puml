@startuml
class Customer {
  vatNumber : String
}

class HeadOfficeAddress {
  address : String
}

class DeliveryAddress {
  address : String
}

class Product {
  currentStock : Integer
}

class Order {
  shippingStatus : OrderShippingStatus
}

class OrderLine {
  quantity : Integer
}

class Invoice {
  paymentTiming : PaymentTiming
}

class Payment {
  paidAt : DateTime
}

class Shipment {
  status : ShipmentStatus
  packedAt : DateTime
  shippedAt : DateTime
  receivedAt : DateTime
}

enum OrderShippingStatus {
  TO_BE_SHIPPED
  PARTIALLY_SHIPPED
  FULLY_SHIPPED
}

enum PaymentTiming {
  AT_ORDER_PLACEMENT
  AFTER_DELIVERY
}

enum ShipmentStatus {
  PACKED
  SHIPPED
  RECEIVED
}

Customer "1" *-- "1" HeadOfficeAddress
Customer "1" *-- "0..*" DeliveryAddress
Customer "1" -- "0..*" Order
DeliveryAddress "1" -- "0..*" Order
Order "1" *-- "1..*" OrderLine
Product "1" -- "0..*" OrderLine
Order "1" *-- "1" Invoice
Invoice "1" *-- "0..1" Payment
Order "1" *-- "0..*" Shipment
Shipment "0..1" -- "1..*" OrderLine
@enduml

@startuml
class Station {
  id : String
  address : String
}

class FuelPump {
  number : Integer
  selfService : Boolean
}

class Fuel {
  name : String
  octaneRating : Integer
}

class DailyFuelPrice {
  date : Date
  pricePerLiter : Decimal
}

class FuelPurchase {
  id : String
  volumeLiters : Decimal
}

Station "1" *-- "1..12" FuelPump
FuelPump "0..*" -- "1..*" Fuel
Station "1" *-- "0..*" DailyFuelPrice
Fuel "1" -- "0..*" DailyFuelPrice
FuelPump "1" -- "0..*" FuelPurchase
Fuel "1" -- "0..*" FuelPurchase
DailyFuelPrice "1" -- "0..*" FuelPurchase
@enduml

@startuml
class ElderlyHome {
}

class Department {
}

class Room {
}

class Bed {
}

class BedCategory {
  type : StayType
  price : Decimal
}

enum StayType {
  RH
  RNH
  SF
}

class Person {
}

class Inhabitant {
}

class Registration {
  registrationDate : Date
}

class Question {
  text : String
}

class IdentificationQuestion {
}

class AbilityQuestion {
}

class RegistrationAnswer {
  value : String
}

class Assessment {
  assessmentDate : Date
  kind : AssessmentKind
}

enum AssessmentKind {
  INITIAL
  REASSESSMENT
}

class AssessmentAnswer {
  value : String
}

class WaitingList {
}

class WaitingListEntry {
}

class Proposal {
  proposalDate : Date
  responseDueDate : Date
  responseDate : Date
  intakeDate : Date
  status : ProposalStatus
}

enum ProposalStatus {
  PROPOSED
  ACCEPTED
  REFUSED
  INVALIDATED
}

class Stay {
  startDate : Date
  endDate : Date
  status : StayStatus
  endReason : StayEndReason
}

enum StayStatus {
  ACTIVE
  SUSPENDED
  ENDED
}

enum StayEndReason {
  DEATH
  MOVED
}

class Invoice {
  invoiceDate : Date
  billingPeriod : String
  totalAmount : Decimal
  outstandingAmount : Decimal
  status : InvoiceStatus
}

enum InvoiceStatus {
  OUTSTANDING
  PAID
}

class InvoiceItem {
  amount : Decimal
  discountAmount : Decimal
}

class CreditNote {
  creationDate : Date
  amount : Decimal
}

Person <|-- Inhabitant
Question <|-- IdentificationQuestion
Question <|-- AbilityQuestion

ElderlyHome "1" *-- "1..*" Department
Department "1" *-- "1..*" Room
Room "1" *-- "1..*" Bed
ElderlyHome "1" o-- "1..*" BedCategory
BedCategory "1" -- "0..*" Bed

Person "1" -- "1" Registration
Registration "1" *-- "1..*" RegistrationAnswer
IdentificationQuestion "1" -- "0..*" RegistrationAnswer

Person "1" -- "0..*" Assessment
Assessment "1" *-- "1..*" AssessmentAnswer
AbilityQuestion "1" -- "0..*" AssessmentAnswer
BedCategory "1" -- "0..*" Assessment

BedCategory "1" -- "1" WaitingList
WaitingList "1" *-- "0..*" WaitingListEntry
Person "1" -- "0..*" WaitingListEntry
WaitingListEntry "1" -- "0..*" Proposal
Bed "1" -- "0..*" Proposal
Proposal "0..1" -- "0..1" Assessment

Inhabitant "1" -- "0..*" Stay
Bed "1" -- "0..*" Stay
BedCategory "1" -- "0..*" Stay
Proposal "0..1" -- "0..1" Stay

Inhabitant "1" -- "0..*" Invoice
Invoice "1" *-- "1..*" InvoiceItem
Stay "1" -- "0..*" InvoiceItem
Invoice "1" *-- "0..*" CreditNote
@enduml

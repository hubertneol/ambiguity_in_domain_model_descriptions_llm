@startuml
class Kinepolis {
}

class Town {
}

class Cinema {
}

class Theatre {
}

class Seat {
  number : String
}

class Movie {
}

class MovieCopy {
}

class WeeklyProgram {
  publicationDate : Date
  startDate : Date
  endDate : Date
}

class Show {
  startDateTime : DateTime
  status : ShowStatus
}

class Customer {
  name : String
  homeAddress : String
}

class SeatReservation {
  reservationDateTime : DateTime
  cancellationDateTime : DateTime
  status : ReservationStatus
}

class CreditCard {
}

class CreditCardPayment {
  debitDateTime : DateTime
  status : PaymentStatus
}

class ReplacementOffer {
  expirationDateTime : DateTime
  status : OfferStatus
}

class Ticket {
}

class EntranceTicket {
  customerName : String
}

class FreeTicket {
}

enum ShowStatus {
  PROGRAMMED
  PUBLISHED
  CANCELLED
}

enum ReservationStatus {
  ACTIVE
  CANCELLED
}

enum PaymentStatus {
  PENDING
  DEBITED
  CANCELLED
}

enum OfferStatus {
  PENDING
  ACCEPTED
  DECLINED
  EXPIRED
}

Kinepolis "1" *-- "1..*" Cinema
Town "1" -- "0..1" Cinema
Cinema "1" *-- "1..*" Theatre
Theatre "1" *-- "1..*" Seat
Kinepolis "1" *-- "0..*" WeeklyProgram
WeeklyProgram "1" *-- "1..*" Show
Theatre "1" -- "0..*" Show
Movie "1" -- "0..*" Show
Movie "1" *-- "0..*" MovieCopy
Cinema "1" -- "0..*" MovieCopy
MovieCopy "1" -- "0..*" Show
Customer "1" -- "0..*" SeatReservation
Show "1" -- "0..*" SeatReservation
Seat "1" -- "0..*" SeatReservation
SeatReservation "1" *-- "1" CreditCardPayment
CreditCard "1" -- "0..*" CreditCardPayment
SeatReservation "1" -- "0..1" ReplacementOffer
Show "1" -- "0..*" ReplacementOffer
Seat "1" -- "0..*" ReplacementOffer
Ticket <|-- EntranceTicket
Ticket <|-- FreeTicket
Show "1" -- "0..*" EntranceTicket
Seat "1" -- "0..*" EntranceTicket
SeatReservation "1" -- "0..1" FreeTicket
Customer "1" -- "0..*" FreeTicket
@enduml

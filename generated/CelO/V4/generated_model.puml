@startuml
class Person {
  firstName : String
  lastName : String
  emailAddress : String
  password : String
}

class Organizer {
  postalAddress : String
  phoneNumber : String
}

class Attendee {
}

class Event {
  startDate : Date
  startTime : Time
  endDate : Date
  endTime : Time
  occasion : String
}

class EventType {
  name : String
}

class Location {
  name : String
  address : String
}

class Invitation {
  firstName : String
  lastName : String
  emailAddress : String
  responseStatus : InvitationStatus
}

class ChecklistTask {
  description : String
}

class EventTask {
  status : TaskStatus
  designatedForAttendees : Boolean
}

enum InvitationStatus {
  OUTSTANDING
  WILL_COME
  MIGHT_COME
  CANNOT_COME
}

enum TaskStatus {
  NEEDS_COMPLETION
  COMPLETED
  INAPPLICABLE
}

Person <|-- Organizer
Person <|-- Attendee

Organizer "1..*" -- "0..*" Event
EventType "1" -- "0..*" Event
Location "1" -- "0..*" Event
EventType "1" -- "0..*" ChecklistTask
Event "1" *-- "0..*" Invitation
Attendee "0..1" -- "0..*" Invitation
Event "1" *-- "0..*" EventTask
ChecklistTask "1" -- "0..*" EventTask
Invitation "0..1" -- "0..*" EventTask
@enduml

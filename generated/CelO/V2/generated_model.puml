@startuml
class Person {
  firstName : String
  lastName : String
  email : String
}

class Organizer {
  postalAddress : String
  phoneNumber : String
  password : String
}

class Attendee {
}

class AttendeeAccount {
  username : String
  password : String
}

class Event {
  startDateTime : DateTime
  endDateTime : DateTime
  occasion : String
}

class EventKind {
  name : String
}

class Location {
  name : String
  address : String
}

class Invitation {
  status : InvitationStatus
}

class Task {
  description : String
}

class ChecklistItem {
  status : TaskStatus
  designatedForAttendees : Boolean
}

enum InvitationStatus {
  NOT_REPLIED
  ATTENDING
  MAYBE_ATTENDING
  NOT_ATTENDING
}

enum TaskStatus {
  NEEDS_TO_BE_DONE
  DONE
  NOT_APPLICABLE
}

Person <|-- Organizer
Person <|-- Attendee
Attendee "1" *-- "0..1" AttendeeAccount
Organizer "1..*" -- "0..*" Event
EventKind "1" -- "0..*" Event
Location "1" -- "0..*" Event
EventKind "1" *-- "0..*" Task
Event "1" *-- "0..*" Invitation
Attendee "1" -- "0..*" Invitation
Event "1" *-- "0..*" ChecklistItem
Task "1" -- "0..*" ChecklistItem
Attendee "0..*" -- "0..*" ChecklistItem
@enduml

@startuml
class Account {
  emailAddress : String
  password : String
}

class Organizer {
  firstName : String
  lastName : String
  postalAddress : String
  phoneNumber : String
}

class Event {
  occasion : String
  startDateTime : DateTime
  endDateTime : DateTime
}

class EventKind {
  name : String
}

class Location {
  name : String
  address : String
}

class Invitation {
  firstName : String
  lastName : String
  emailAddress : String
  status : InvitationStatus
}

class TaskDefinition {
  description : String
}

class EventTask {
  status : TaskStatus
  designatedForAttendees : Boolean
}

enum InvitationStatus {
  NOT_REPLIED
  WILL_ATTEND
  MAYBE_ATTEND
  CANNOT_ATTEND
}

enum TaskStatus {
  NEEDS_TO_BE_DONE
  DONE
  NOT_APPLICABLE
}

Account <|-- Organizer
Organizer "1..*" -- "0..*" Event
Organizer "1" -- "0..*" Invitation
EventKind "1" -- "0..*" Event
Location "1" -- "0..*" Event
Event "1" *-- "0..*" Invitation
Account "0..1" -- "0..*" Invitation
EventKind "1" *-- "0..*" TaskDefinition
Event "1" *-- "0..*" EventTask
TaskDefinition "1" -- "0..*" EventTask
Invitation "0..1" -- "0..*" EventTask
@enduml

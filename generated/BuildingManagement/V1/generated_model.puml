}

Visitor <|-- User
User <|-- Administrator
AdditionalEntry <|-- TextualEntry
AdditionalEntry <|-- NumericEntry

WebPortal "1" o-- "0..*" Building
WebPortal "1" o-- "0..*" User
User "1" -- "0..*" Building
Building "1" *-- "0..*" AdditionalEntry
Building "1" *-- "1..*" Image
Building "1" -- "1" Image
Building "1" *-- "0..*" Comment
User "1" -- "0..*" Comment

Visitor "1" -- "0..*" RegisterUser
Visitor "1" -- "0..*" ConfirmEmailAddress
Administrator "1" -- "0..*" SetUpUserAccount
WebPortal "1" -- "0..*" ActivateUser
User "1" -- "0..*" LogIn
Visitor "1" -- "0..*" SearchBuildings
User "1" -- "0..*" CreateBuilding
User "1" -- "0..*" ManageBuildingEntries
User "1" -- "0..*" CommentOnBuilding
Administrator "1" -- "0..*" DeleteComment

RegisterUser "1" *-- "1" ConfirmEmailAddress

@startuml
class BusCompany {
  name : String
}

class Bus {
}

class Line {
  number : String
}

class LineCategory {
  name : String
  tripPrice : Decimal
}

class Trajectory {
  destination : String
  operationalFrom : Date
  cancelledAt : DateTime
}

class Suspension {
  startAt : DateTime
  endAt : DateTime
}

class TownAuthority {
}

class ApprovalRequest {
  submittedOn : Date
  decidedOn : Date
  outcome : ApprovalOutcome
}

enum ApprovalOutcome {
  REFUSED_WITHOUT_APPEAL
  CHANGE_REQUIRED
  APPROVED
}

class Customer {
  homeAddress : String
  officeAddress : String
  workingHours : String
}

class SeasonTicket {
}

class MENSOTicket {
  validFrom : Date
  validUntil : Date
}

class MENSOTrip {
  tripDate : Date
  tripTime : Time
  price : Decimal
}

class Invoice {
  billingMonth : String
  totalAmount : Decimal
  discountPercentage : Decimal
}

class Payment {
  paymentDate : Date
  amount : Decimal
}

SeasonTicket <|-- MENSOTicket

BusCompany "1" -- "1..*" Bus
BusCompany "1" -- "1..*" Line
BusCompany "1" -- "1..*" Trajectory
BusCompany "1" -- "0..*" Customer
BusCompany "1" -- "0..*" ApprovalRequest

LineCategory "1" -- "0..*" Line
Line "1" o-- "1..*" Trajectory
Trajectory "0..*" -- "0..*" Bus
Trajectory "1" *-- "0..*" Suspension
Trajectory "1" -- "0..*" ApprovalRequest
TownAuthority "1" -- "0..*" ApprovalRequest

Customer "1" -- "0..*" MENSOTicket
MENSOTicket "1" -- "0..*" MENSOTrip
Line "1" -- "0..*" MENSOTrip

Customer "1" -- "0..*" Invoice
Invoice "0..1" -- "0..*" MENSOTrip
Invoice "1" -- "0..1" Payment
@enduml

@startuml
class Employee {
  name : String
  socialSecurityNumber : String
}

class CreativeEmployee {
}

class Director {
  assistantName : String
  hasOscar : Boolean
}

class Actor {
  education : String
  hasOscar : Boolean
}

class Technician {
  fieldOfActivity : String
}

class FilmSet {
  location : String
}

class Film {
  title : String
  yearOfRelease : Integer
  genre : Genre
}

enum Genre {
  THRILLER
  ACTION
  HORROR
  COMEDY
}

class Screenwriter {
  name : String
}

class Screenplay {
  title : String
  version : String
  date : Date
  numberOfScenes : Integer
  plot : String
}

class SourceMaterial {
}

class Novel {
  title : String
  author : String
}

class Concept {
}

Employee <|-- CreativeEmployee
CreativeEmployee <|-- Director
CreativeEmployee <|-- Actor
Employee <|-- Technician
SourceMaterial <|-- Novel
SourceMaterial <|-- Concept

FilmSet "1" -- "1..*" Employee
FilmSet "0..*" -- "0..*" Film
Screenwriter "0..*" -- "1" Film
Screenwriter "1" -- "1..*" Screenplay
SourceMaterial "1" -- "0..*" Screenplay
Film "1" -- "1" Screenplay
Director "1" -- "0..*" Film
Director "1" -- "0..*" Screenplay
Actor "0..*" -- "0..*" Film
Actor "0..*" -- "0..*" Screenplay
@enduml

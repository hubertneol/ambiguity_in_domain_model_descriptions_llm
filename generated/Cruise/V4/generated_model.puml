@startuml
class Provider {
  name : String
  location : String
}

class Cruise {
  number : String
  name : String
  startDate : Date
  endDate : Date
}

class Employee {
  name : String
  socialSecurityNumber : String
}

class Guest {
  name : String
  vipStatus : Boolean
}

class Ship {
  name : String
  deckCount : Integer
  length : Real
  passengerCount : Integer
}

class Booking {
  bookingNumber : String
  bookingDate : Date
}

class TravelAgency {
  name : String
  address : String
}

class DestinationArea {
  name : String
  seaName : String
}

class Show {
  title : String
  duration : Duration
}

class Ticket {
}

Provider "1" -- "0..*" Cruise
Cruise "0..*" -- "1..*" Employee
Cruise "0..*" -- "1..*" Guest
Ship "1" -- "0..*" Cruise
Cruise "1" -- "0..*" Booking
TravelAgency "1" -- "0..*" Booking
DestinationArea "1" -- "0..*" Cruise
Cruise "1" -- "1..*" Show
Guest "0..*" -- "0..*" Show
Cruise "1" -- "1..*" Ticket
Guest "1" -- "0..*" Ticket
@enduml

@startuml
class Game {
  id : ID
}

class Player {
  id : ID
}

class Deck {
  id : ID
}

class Card {
  id : ID
  suit : Suit
}

class ScoringTable {
  id : ID
}

class Round {
  id : ID
  pointValue : Integer
}

class JackRound {
}

class SoloRound {
  soloType : SoloType
}

class MandatorySoloRound {
}

enum Suit {
  DIAMONDS
  HEARTS
  SPADES
  CLUBS
}

enum ComparisonResult {
  LOWER
  EQUAL
  HIGHER
}

enum SoloType {
  TRUMP
  JACK
  QUEEN
}

Round <|-- JackRound
Round <|-- SoloRound
SoloRound <|-- MandatorySoloRound

Game "1" *-- "4" Player
Game "1" *-- "1" Deck
Game "1" *-- "1" ScoringTable
Deck "1" *-- "0..48" Card
ScoringTable "1" *-- "0..*" Round
Round "0..*" -- "1..*" Player
SoloRound "0..*" -- "1" Player
@enduml

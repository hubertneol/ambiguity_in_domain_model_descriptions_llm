@startuml
class User {
  id : String
  name : String
  email : String
  birthDate : Date
}

class Account {
  accountNumber : String
}

class PersonalAccount {
}

class BusinessAccount {
  companyName : String
  monthlyFee : Decimal
}

class Page {
  name : String
  visitCount : Integer
}

class AdvertisementPage {
  bounceRate : Decimal
  clickThroughRate : Decimal
  conversionRate : Decimal
}

class Privilege {
}

Account <|-- PersonalAccount
Account <|-- BusinessAccount
Page <|-- AdvertisementPage

User "1" -- "1" Account
Account "1" *-- "0..*" Page
BusinessAccount "1" -- "0..*" AdvertisementPage
PersonalAccount "0..*" -- "0..*" PersonalAccount
PersonalAccount "1" -- "0..*" Privilege
Page "1" -- "0..*" Privilege
@enduml

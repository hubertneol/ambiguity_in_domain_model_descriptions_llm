@startuml
class User {
  id : String
  name : String
  email : String
  dateOfBirth : Date
}

class Account {
  accountNumber : String
}

class BusinessAccount {
  companyName : String
  monthlyFee : Decimal
}

class PersonalAccount {
}

class Page {
  pageName : String
  numberOfVisits : Integer
}

class AdvertisementPage {
  bounceRate : Decimal
  clickThroughRate : Decimal
  conversionRate : Decimal
}

class FriendRequest {
}

class Privilege {
}

Account <|-- BusinessAccount
Account <|-- PersonalAccount
Page <|-- AdvertisementPage

User "1" -- "1" Account
Account "1" *-- "0..*" Page

PersonalAccount "1" -- "0..*" FriendRequest
FriendRequest "0..*" -- "1" PersonalAccount

PersonalAccount "1" -- "0..*" Privilege
Page "1" -- "0..*" Privilege
@enduml

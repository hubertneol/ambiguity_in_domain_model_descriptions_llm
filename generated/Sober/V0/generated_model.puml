@startuml
class Car {
}

class SoberOwnedCar {
}

class RegisteredCar {
}

class CarOwner {
}

class Customer {
  customerNumber : String
  name : String
}

class TaxiService {
  pickupTime : DateTime
  dropoffTime : DateTime
  pickupLocation : Location
  dropoffLocation : Location
  rideDuration : Duration
  distance : Decimal
}

class RideHailService {
  numberOfPassengers : Integer
  fee : Decimal
  requestType : RequestType
}

class RideShareService {
  numberOfCustomers : Integer
  negotiatedFee : Decimal
}

class Accident {
  date : Date
  location : Location
  damageAmount : Decimal
}

enum RequestType {
  SOBER_APP
  HAND_WAVING
}

Car <|-- SoberOwnedCar
Car <|-- RegisteredCar
TaxiService <|-- RideHailService
TaxiService <|-- RideShareService

CarOwner "1" -- "1..*" RegisteredCar
Car "1" -- "0..*" TaxiService
Car "1" -- "0..*" Accident
Customer "1" -- "0..*" RideHailService
Customer "1..10" -- "0..*" RideShareService
@enduml

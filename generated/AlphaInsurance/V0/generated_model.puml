@startuml
class InsuranceCompany {
    name : String
}

class Customer {
}

class Broker {
    registeredInSystem : Boolean
}

class CustomerFile {
}

class PolicyInterest {
}

class InsurancePolicyType {
    name : String
}

class InsuranceProduct {
    name : String
    price : Decimal
}

class ProfileAssessment {
    assessmentDate : Date
    trustworthy : Boolean
    method : AssessmentMethod
}

enum AssessmentMethod {
    ON_THE_SPOT
    HEAD_OFFICE_ANALYSIS
}

class Offer {
    offerDate : Date
    deliveryMethod : OfferDeliveryMethod
    status : OfferStatus
}

enum OfferDeliveryMethod {
    IN_PERSON
    EMAIL
}

enum OfferStatus {
    OFFERED
    ACCEPTED
    DECLINED
}

class Contract {
    signedDate : Date
    signedByCustomer : Boolean
    signedByCompany : Boolean
    billingFrequency : BillingFrequency
}

enum BillingFrequency {
    MONTHLY
    YEARLY
}

class Invoice {
    invoiceDate : Date
    amount : Decimal
}

class InsuredEvent {
    occurrenceDate : Date
}

class Claim {
    submissionDate : Date
}

class ClaimCase {
    complete : Boolean
    status : ClaimCaseStatus
}

enum ClaimCaseStatus {
    OPEN
    UNDER_ASSESSMENT
    APPROVED
    REJECTED
}

class Estimator {
}

class ExpertiseArea {
    name : String
}

class EstimatorReport {
    issueDate : Date
    content : String
    storedUntil : Date
}

class SuppliedDocument {
    documentedCost : Decimal
}

class CompensationDecision {
    decisionDate : Date
    totalCompensation : Decimal
}

class EligibleCost {
    originalAmount : Decimal
    refundAmount : Decimal
}

class CompensationPayment {
    paymentDate : Date
    amount : Decimal
}

class CustomerAccount {
}

InsuranceCompany "1" -- "0..*" Customer
InsuranceCompany "1" -- "0..*" Broker
InsuranceCompany "1" -- "0..*" InsuranceProduct
Broker "1" -- "0..*" Customer
Customer "1" *-- "1" CustomerFile
Customer "1" *-- "0..*" PolicyInterest
InsurancePolicyType "1" -- "0..*" PolicyInterest
InsurancePolicyType "1" -- "0..*" InsuranceProduct
CustomerFile "1" *-- "0..*" ProfileAssessment
Broker "0..1" -- "0..*" ProfileAssessment
ProfileAssessment "0..1" -- "0..*" Offer
Customer "1" -- "0..*" Offer
Broker "1" -- "0..*" Offer
InsuranceProduct "1" -- "0..*" Offer
Offer "1" -- "0..1" Contract
Customer "1" -- "0..*" Contract
Broker "1" -- "0..*" Contract
InsuranceCompany "1" -- "0..*" Contract
InsuranceProduct "1" -- "0..*" Contract
Contract "1" *-- "0..*" Invoice
Contract "1" -- "0..*" InsuredEvent
InsuredEvent "1" -- "0..1" Claim
Customer "1" -- "0..*" Claim
Contract "1" -- "0..*" Claim
Claim "1" *-- "1..*" ClaimCase
InsuranceCompany "1" -- "0..*" ClaimCase
ExpertiseArea "1" -- "0..*" Estimator
ClaimCase "1" -- "0..*" EstimatorReport
Estimator "1" -- "0..*" EstimatorReport
ClaimCase "1" *-- "0..*" SuppliedDocument
ClaimCase "1" *-- "0..1" CompensationDecision
CompensationDecision "1" *-- "0..*" EligibleCost
SuppliedDocument "0..*" -- "0..*" EligibleCost
CompensationDecision "1" *-- "0..1" CompensationPayment
Customer "1" -- "0..*" CustomerAccount
CustomerAccount "1" -- "0..*" CompensationPayment
@enduml

@startuml
class InsuranceCompany {
}

class HeadOffice {
}

class Broker {
}

class Customer {
}

class CustomerFile {
}

class ProfileAssessment {
  trustworthy : Boolean
  location : AssessmentLocation
}

enum AssessmentLocation {
  ON_THE_SPOT
  HEAD_OFFICE
}

class InsurancePolicyType {
}

class InsuranceProduct {

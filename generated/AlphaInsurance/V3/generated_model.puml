@startuml
class InsuranceCompany {
  name : String
}

class Customer {
  customerId : String
}

class Broker {
  brokerId : String
  registered : Boolean
}

class CustomerFile {
  fileId : String
}

class InsuranceRequest {
  requestDate : Date
}

class InsuranceProduct {
  productId : String
  name : String
  policyType : String
  price : Decimal
}

class ProfileAssessment {
  assessmentDate : Date
  method : AssessmentMethod
  trustworthy : Boolean
}

enum AssessmentMethod {
  ON_SPOT
  HEAD_OFFICE_ANALYSIS
}

class Offer {
  offerId : String
  offerDate : Date
  deliveryMethod : OfferDeliveryMethod
  accepted : Boolean
}

enum OfferDeliveryMethod {
  IN_PERSON
  EMAIL
}

class Contract {
  contractId : String
  signingDate : Date
  billingFrequency : BillingFrequency
  coverage : String
}

enum BillingFrequency {
  MONTHLY
  YEARLY
}

class Invoice {
  invoiceId : String
  invoiceDate : Date
  amount : Decimal
}

class Claim {
  claimId : String
  submissionDate : Date
  insuredEventDescription : String
}

class ClaimCase {
  caseId : String
  complete : Boolean
  approved : Boolean
}

class Estimator {
  estimatorId : String
  areaOfExpertise : String
}

class AssessmentReport {
  reportId : String
  issueDate : Date
  storedUntil : Date
}

class SupportingDocument {
  documentId : String
}

class CompensationDecision {
  decisionId : String
  decisionDate : Date
  compensationSum : Decimal
}

class EligibleCost {
  description : String
  eligibleRefundAmount : Decimal
}

class CompensationPayment {
  paymentId : String
  paymentDate : Date
  amount : Decimal
}

class CustomerAccount {
  accountNumber : String
}

InsuranceCompany "1" -- "0..*" Customer
InsuranceCompany "1" -- "0..*" Broker
InsuranceCompany "1" -- "0..*" InsuranceProduct
Customer "1" *-- "1" CustomerFile
Broker "1" -- "0..*" CustomerFile
CustomerFile "1" *-- "0..*" InsuranceRequest
InsuranceRequest "0..*" -- "1..*" InsuranceProduct
CustomerFile "1" *-- "0..*" ProfileAssessment
Broker "0..1" -- "0..*" ProfileAssessment
Customer "1" -- "0..*" Offer
InsuranceProduct "1" -- "0..*" Offer
Offer "1" -- "0..1" Contract
Customer "1" -- "0..*" Contract
InsuranceProduct "1" -- "0..*" Contract
Contract "1" *-- "0..*" Invoice
Customer "1" -- "0..*" Claim
Claim "1" *-- "1..*" ClaimCase
InsuranceCompany "1" -- "0..*" ClaimCase
ClaimCase "1" *-- "0..*" AssessmentReport
Estimator "1" -- "0..*" AssessmentReport
ClaimCase "1" *-- "0..*" SupportingDocument
ClaimCase "1" *-- "0..1" CompensationDecision
CompensationDecision "1" *-- "0..*" EligibleCost
CompensationDecision "1" *-- "0..1" CompensationPayment
Customer "1" *-- "0..*" CustomerAccount
CustomerAccount "1" -- "0..*" CompensationPayment
@enduml

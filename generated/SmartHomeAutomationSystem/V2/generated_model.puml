}

class ActivityLog {
}

class AutomationRule {
  active : Boolean
}

class Precondition {
}

class Expression {
}

class BooleanExpression {
  operator : BooleanOperator
}

class RelationalTerm {
  operator : String
  comparisonValue : String
}

enum BooleanOperator {
  AND
  OR
  NOT
}

class RuleAction {
}

class ActionStep {
  position : Integer
}

class RuleTrigger {
  timestamp : DateTime
}


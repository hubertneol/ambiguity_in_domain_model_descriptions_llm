@startuml
class Aircraft {
  name : String
  type : String
  yearOfManufacture : Integer
  nextInspectionDate : Date
}

class PassengerAircraft {
  numberOfSeats : Integer
}

class Flight {
  flightNumber : String
  date : Date
}

class Passenger {
  name : String
  passportNumber : String
}

class Ticket {
  ticketNumber : String
  price : Decimal
  upgradeDesired : Boolean
}

class SeatCategory {
  designation : String
  offersEntertainmentProgram : Boolean
  numberOfSeats : Integer
}

class Airline {
  name : String
}

class FlightAttendant {
  name : String
  employmentDate : Date
  isChiefStewardOrStewardess : Boolean
}

class Pilot {
  name : String
  employmentDate : Date
  license : String
}

class CaptainAssignment {
}

class CoPilotAssignment {
}

class Airport {
  name : String
  address : String
  numberOfRunways : Integer
}

class DepartureAssignment {
}

class DestinationAssignment {
}

Aircraft <|-- PassengerAircraft

Aircraft "1" -- "1..*" Flight
Airline "0..1" -- "0..*" Aircraft
Airport "0..1" -- "0..*" Aircraft

Flight "1" -- "1..*" Ticket
Passenger "1" -- "0..*" Ticket
SeatCategory "1" -- "0..*" Ticket

PassengerAircraft "1" *-- "0..*" SeatCategory

Airline "1" -- "1..*" FlightAttendant
Airline "1" -- "1..*" Pilot

Flight "0..*" -- "1..*" FlightAttendant

Flight "1" -- "1" CaptainAssignment
Pilot "1" -- "0..*" CaptainAssignment

Flight "1" -- "1..2" CoPilotAssignment
Pilot "1" -- "0..*" CoPilotAssignment

Flight "1" -- "1" DepartureAssignment
Airport "1" -- "0..*" DepartureAssignment

Flight "1" -- "1" DestinationAssignment
Airport "1" -- "0..*" DestinationAssignment
@enduml

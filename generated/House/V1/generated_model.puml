@startuml
enum BuildingMaterial {
  WOOD
  BRICK
  CONCRETE
}

class House {
  address : String
  buildingMaterial : BuildingMaterial
}

class Basement {
  size : Real
  name : String
}

class EarthBasement {
  humidityLevel : Real
}

class ConcreteBasement {
}

class SemiDetachedHouse {
  hasOwnGarden : Boolean
  numberOfWindows : Integer
}

class CarportSemiDetachedHouse {
}

class GarageSemiDetachedHouse {
}

class Carport {
  isDoubleCarport : Boolean
  hasFlatRoof : Boolean
}

class Garage {
  hasAutomaticGarageDoor : Boolean
}

class Company {
  name : String
  address : String
}

class JobLog {
  numberOfHours : Real
  agreedPrice : Decimal
}

House <|-- SemiDetachedHouse
Basement <|-- EarthBasement
Basement <|-- ConcreteBasement
SemiDetachedHouse <|-- CarportSemiDetachedHouse
SemiDetachedHouse <|-- GarageSemiDetachedHouse

House "1" *-- "0..1" Basement
CarportSemiDetachedHouse "1" *-- "2" Carport
GarageSemiDetachedHouse "1" *-- "1" Garage

House "0..*" -- "1..*" Company
House "1" -- "0..*" JobLog
Company "1" -- "0..*" JobLog
@enduml

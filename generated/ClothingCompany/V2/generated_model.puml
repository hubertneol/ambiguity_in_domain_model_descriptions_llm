@startuml
class Product {
  name : String
  description : String
  netPrice : Decimal
}

class Company {
  name : String
}

class Country {
  name : String
  vatRate : Decimal
  currency : String
  euroConversionRate : Decimal
}

class ProductAvailability {
}

class Representative {
  firstName : String
  lastName : String
  socialSecurityNumber : String
  telephoneNumber : String
  emailAddress : String
}

class Customer {
  name : String
  address : String
  telephoneNumber : String
  emailAddress : String
}

class Order {
  orderId : String
  quantity : Integer
  orderDate : Date
  desiredDeliveryDate : Date
}

Company "1" -- "0..*" Product

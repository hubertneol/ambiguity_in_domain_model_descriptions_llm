}

class Faculty {
  name : String
  address : String
}

class Institute {
  name : String
  address : String
}

class Employee {
  socialSecurityNumber : String
  name : String
  emailAddress : String
}

class Dean {
}

class ResearchStaff {
}

class AdministrativeStaff {
}

class ResearchAssistant {
  researchField : String
}

class Lecturer {
}

class Project {
  name : String
  startDate : Date
  endDate : Date
}

class ProjectInvolvement {

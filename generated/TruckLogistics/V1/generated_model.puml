@startuml
class Location {
}

class Address {
}

class Driver {
  firstName : String
  lastName : String
}

class Vehicle {
  number : String
}

class Truck {
  weight : Number
}

class Car {
  numberOfSeats : Integer
}

class Van {
}

class Order {
  executionDate : Date
}

Vehicle <|-- Truck
Vehicle <|-- Car
Vehicle <|-- Van

Location "1" *-- "1" Address
Location "1" *-- "0..*" Driver
Location "1" *-- "0..*" Vehicle

Order "0..*" -- "1" Location : origin
Order "0..*" -- "1" Location : destination
Order "0..1" -- "1..*" Driver
Vehicle "0..*" -- "0..1" Driver
@enduml

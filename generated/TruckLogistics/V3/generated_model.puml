@startuml
class Location {
  address : String
}

class Driver {
  firstName : String
  lastName : String
}

class Vehicle {
  vehicleNumber : String
}

class Truck {
  weight : Decimal
}

class Car {
  numberOfSeats : Integer
}

class Van {
}

class Order {
  origin : Location
  destination : Location
  executionDate : Date
}

Vehicle <|-- Truck
Vehicle <|-- Car
Vehicle <|-- Van

Location "1" *-- "0..*" Driver
Location "1" *-- "0..*" Vehicle
Driver "1..*" -- "0..1" Order
Driver "0..1" -- "0..*" Vehicle
@enduml

@startuml
class Location {
  address : String
}

class Driver {
  firstName : String
  lastName : String
}

class Vehicle {
  vehicleNumber : String
}

class Truck {
  weight : Decimal
}

class Car {
  numberOfSeats : Integer
}

class Van {
}

class Order {
  executionDate : Date
}

Vehicle <|-- Truck
Vehicle <|-- Car
Vehicle <|-- Van

Location "1" *-- "0..*" Driver
Location "1" *-- "0..*" Vehicle

Order "0..*" -- "1" Location : origin
Order "0..*" -- "1" Location : destination
Order "0..1" -- "1..*" Driver
Driver "0..1" -- "0..*" Vehicle
@enduml

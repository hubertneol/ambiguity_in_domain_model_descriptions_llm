@startuml
class User {
  username : String
  password : String
}

class Player {
}

class Admin {
}

class Game {
  name : String
  published : Boolean
  numberOfBlocksPerLevel : Integer
  minimumBallSpeed : Float
  speedIncreaseFactor : Float
  maximumPaddleLength : Float
  minimumPaddleLength : Float
}

class Block {
  color : String
  points : Integer
}

class Level {
  number : Integer
  random : Boolean
}

class BlockPlacement {
  gridX : Integer
  gridY : Integer
}

class HallOfFame {
}

class HallOfFameEntry {
  score : Integer
}

class GameSession {
  totalScore : Integer
  livesRemaining : Integer
  status : SessionStatus
}

class Ball {
  x : Float
  y : Float
  speed : Float
  directionX : Float
  directionY : Float
}

class Paddle {
  x : Float
  length : Float
}

class PlayedBlock {
  gridX : Integer
  gridY : Integer
}

enum SessionStatus {
  IN_PROGRESS
  PAUSED
  AWAITING_CONFIRMATION
  ENDED
}

User <|-- Player
Player <|-- Admin
Admin "1" -- "0..*" Game
Game "1" *-- "1" HallOfFame
Game "1" *-- "1..*" Block
Game "1" *-- "1..99" Level
Level "1" *-- "0..*" BlockPlacement
Block "1" -- "0..*" BlockPlacement
Player "1" -- "0..*" GameSession
Game "1" -- "0..*" GameSession
Level "1" -- "0..*" GameSession
GameSession "1" *-- "1" Ball
GameSession "1" *-- "1" Paddle
GameSession "1" *-- "0..*" PlayedBlock
Block "1" -- "0..*" PlayedBlock
HallOfFame "1" *-- "0..*" HallOfFameEntry
Player "1" -- "0..*" HallOfFameEntry
GameSession "1" -- "0..1" HallOfFameEntry
@enduml

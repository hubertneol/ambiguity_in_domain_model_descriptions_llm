@startuml
class User {
  username : String
  password : String
}

class Player {
}

class Admin {
}

class Game {
  name : String
  published : Boolean
  numberOfBlocksPerLevel : Integer
  minimumBallSpeed : Real
  speedIncreaseFactor : Real
  maximumPaddleLength : Real
  minimumPaddleLength : Real
}

class Block {
  color : String
  points : Integer
}

class Level {
  number : Integer
  random : Boolean
}

class BlockPlacement {
  gridColumn : Integer
  gridRow : Integer
}

class HallOfFame {
}

class HallOfFameEntry {
  score : Integer
}

class GameSession {
  score : Integer
  lives : Integer
  status : GameSessionStatus
}

enum GameSessionStatus {
  PLAYING
  PAUSED
  AWAITING_LEVEL_CONFIRMATION
  ENDED
}

class Ball {
  xPosition : Real
  yPosition : Real
  speed : Real
  direction : String
}

class Paddle {
  xPosition : Real
  length : Real
}

class PlayedBlock {
  gridColumn : Integer
  gridRow : Integer
}

User <|-- Player
Player <|-- Admin
Admin "1" -- "0..*" Game
Game "1" *-- "1" HallOfFame
Game "1" *-- "1..*" Block
Game "1" *-- "1..99" Level
Level "1" *-- "0..*" BlockPlacement
Block "1" -- "0..*" BlockPlacement
Player "1" -- "0..*" GameSession
Game "1" -- "0..*" GameSession
Level "1" -- "0..*" GameSession
GameSession "1" *-- "1" Ball
GameSession "1" *-- "1" Paddle
GameSession "1" *-- "0..*" PlayedBlock
Block "1" -- "0..*" PlayedBlock
HallOfFame "1" *-- "0..*" HallOfFameEntry
GameSession "1" -- "0..1" HallOfFameEntry
@enduml

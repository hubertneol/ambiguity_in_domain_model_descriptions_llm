@startuml
enum PriorityScore {
  HIGH
  LOW
}

enum TreatmentStage {
  STAGE_1
  STAGE_2
  STAGE_3
}

enum ConsentStatus {
  SIGNED
  RETRACTED
}

class Hospital {
}

class Patient {
}

class Doctor {
}

class HeadDoctor {
}

class Nurse {
}

class Illness {
  priorityScore : PriorityScore
}

class Diagnosis {
}

class Treatment {
}

class AppliedTreatment {
  stage : TreatmentStage
}

class ConsentForm {
  status : ConsentStatus
}

class FollowUpCheck {
}

Doctor <|-- HeadDoctor

Hospital "1" -- "0..*" Patient
Hospital "1" -- "0..*" Doctor
Hospital "1" -- "0..*" Nurse
Hospital "1" -- "1" HeadDoctor
Hospital "1" -- "0..*" Illness

Patient "0..*" -- "1..*" Doctor
Patient "1" -- "0..*" Diagnosis
Doctor "1" -- "0..*" Diagnosis
HeadDoctor "0..1" -- "0..*" Diagnosis
Illness "1" -- "0..*" Diagnosis

Illness "1" -- "0..*" Treatment
Diagnosis "1" -- "0..*" AppliedTreatment
Treatment "1" -- "0..*" AppliedTreatment

Patient "1" -- "0..1" ConsentForm

Patient "1" -- "0..*" FollowUpCheck
AppliedTreatment "1" -- "0..*" FollowUpCheck
Doctor "0..*" -- "0..*" FollowUpCheck
Nurse "0..*" -- "0..*" FollowUpCheck
@enduml
